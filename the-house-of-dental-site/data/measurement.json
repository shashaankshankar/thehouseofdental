{
  "version": "phase-9-v1",
  "status": "vendor-neutral_local_contract_no_nonessential_tracking_enabled",
  "conversionEvents": [
    "click_to_call",
    "appointment_click",
    "form_start",
    "appointment_submit_success",
    "contact_submit_success",
    "directions_click",
    "financing_click",
    "offer_claim",
    "referral_submit_success",
    "implant_inquiry",
    "facial_aesthetics_inquiry",
    "quietnite_inquiry",
    "emergency_call"
  ],
  "diagnosticEvents": ["form_state"],
  "allowedFields": [
    "event",
    "page_type",
    "service_slug",
    "cta_location",
    "conversion_type",
    "campaign_source",
    "state"
  ],
  "stateValues": [
    "activated",
    "started",
    "success",
    "failure",
    "blocked",
    "validation_error",
    "timeout"
  ],
  "attribution": {
    "storage": "sessionStorage",
    "retention": "current_browser_session_only",
    "allowedQueryKeys": ["utm_source", "utm_medium", "utm_campaign", "utm_content"],
    "excludedQueryKeys": ["utm_term"],
    "valueRule": "lowercase ASCII campaign tokens only; maximum 80 characters; reject spaces, query syntax, email-like values, and free text",
    "referrerRule": "store hostname only; drop path, query, fragment, and same-origin referrers",
    "eventProjection": "emit campaign_source only; do not emit raw UTM values or referrer URLs"
  },
  "debug": {
    "queryParam": "hod_debug",
    "acceptedValues": ["1", "true"],
    "buffers": ["window.__HOD_EVENTS__", "window.dataLayer"],
    "network": "disabled"
  },
  "prohibitedPayloadKeys": [
    "name",
    "phone",
    "email",
    "message",
    "symptoms",
    "diagnosis",
    "treatment_details",
    "referral_friend_data",
    "page_content",
    "referrer_url",
    "utm_term"
  ]
}
